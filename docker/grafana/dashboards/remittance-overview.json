          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"transfer\",uri=\"/transfers\",method=\"POST\"}[1m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "B"
        }
      ],
