      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{service=\"transfer\",uri=\"/transfers\",method=\"POST\"}[1m])))",
          "legendFormat": "p95",
